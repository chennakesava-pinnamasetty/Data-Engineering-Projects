										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".csv"
									}
								},
								"enableStaging": false,
								"translator": {
									"value": "@if(\r\n    equals(item().file_name, 'customers.csv'),\r\n    pipeline().parameters.p_customers,\r\n    if(\r\n        equals(item().file_name, 'department.csv'),\r\n        pipeline().parameters.p_department,\r\n        if(\r\n            equals(item().file_name, 'employees.csv'),\r\n            pipeline().parameters.p_employees,\r\n            if(\r\n                equals(item().file_name, 'orders.csv'),\r\n                pipeline().parameters.p_orders,\r\n                if(\r\n                    equals(item().file_name, 'products.csv'),\r\n                    pipeline().parameters.p_products,\r\n                    ''\r\n                )\r\n            )\r\n        )\r\n    )\r\n)",
									"type": "Expression"
								}
							},
							"inputs": [
								{
									"referenceName": "DelimitedText4",
									"type": "DatasetReference",
									"parameters": {
										"p_name": {
											"value": "@item().file_name",
											"type": "Expression"
										}
									}
								}
							],

{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ProductBasedDF"
		},
		"DBSinkInContainers_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'DBSinkInContainers'"
		},
		"HttpServer1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'HttpServer1'"
		},
		"SqlDatabaseToContainers_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'SqlDatabaseToContainers'"
		},
		"DBSinkInContainers_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stproductsretail.dfs.core.windows.net/"
		},
		"HttpServer1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com/"
		},
		"HttpServer1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "chennakesava"
		},
		"SqlDatabaseToContainers_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sr-productsdb.database.windows.net"
		},
		"SqlDatabaseToContainers_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "productdb"
		},
		"SqlDatabaseToContainers_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "chennakesava"
		}
